# ============================================================================
# Mideli - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local (already gitignored).
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase (https://app.supabase.com/project/_/settings/api)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # SERVER ONLY - never expose to client

# Private vendor control for /control/licencia. Use a long random value.
MIDELI_LICENSE_ADMIN_SECRET=replace-with-a-long-random-secret
# Signs the private 30-minute vendor session. Use a different random value.
MIDELI_LICENSE_SESSION_SECRET=replace-with-another-long-random-secret

# ----------------------------------------------------------------------------
# Resend (https://resend.com/api-keys)
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Mideli <noreply@mideli.com>
# Keep false until the sender domain is verified. Only exact `true` enables email.
OWNER_REPORT_EMAIL_ENABLED=false

# Protects the daily owner report endpoint invoked by Vercel Cron.
# Use a random value with at least 16 characters.
CRON_SECRET=replace-with-a-long-random-secret

# ----------------------------------------------------------------------------
# Twilio (https://console.twilio.com/)
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ----------------------------------------------------------------------------
# WhatsApp Cloud API de Meta
# Mantener desactivado y en dry-run hasta completar el piloto local.
# ----------------------------------------------------------------------------
WHATSAPP_ORDERS_ENABLED=false
WHATSAPP_ORDER_CREATION_ENABLED=false
WHATSAPP_PROVIDER=simulator
WHATSAPP_DRY_RUN=true
WHATSAPP_TEST_ALLOWLIST=
META_GRAPH_API_VERSION=v25.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Respaldo semántico del flujo conversacional. La clave es solo de servidor.
# Usa false como interruptor de emergencia sin retirar la clave.
WHATSAPP_GEMINI_INTERPRETER_ENABLED=true
WHATSAPP_GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Clave de servidor restringida a Geocoding API y Routes API.
# Nunca usar una clave pública del navegador en el webhook.
GOOGLE_MAPS_SERVER_API_KEY=

# ----------------------------------------------------------------------------
# Polar (https://polar.sh/settings)
# Use sandbox for development: https://sandbox-api.polar.sh
# ----------------------------------------------------------------------------
POLAR_ACCESS_TOKEN=polar_at_xxxxxxxxxxxx
POLAR_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
POLAR_SERVER=sandbox

# ----------------------------------------------------------------------------
# Sentry (https://sentry.io)
# Monitoring only: errors and sampled traces. Do not enable PII or Replay.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@o0.ingest.sentry.io/0
SENTRY_DSN=https://PUBLIC_KEY@o0.ingest.sentry.io/0
SENTRY_ORG=mideli
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token # BUILD ONLY - never expose to client
